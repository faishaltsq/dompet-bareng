{
  "expo": {
    "name": "Dompet Bareng",
    "slug": "dompet-bareng",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dompetbareng",
    "userInterfaceStyle": "automatic",
    "privacyPolicyUrl": "https://dompet-bareng.vercel.app/privacy",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dompetbareng.app",
      "associatedDomains": [
        "applinks:dompetbareng.app"
      ]
    },
    "android": {
      "package": "com.dompetbareng.app",
      "versionCode": 4,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#FBF7F0",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "dompetbareng"
            },
            {
              "scheme": "https",
              "host": "dompetbareng.app",
              "pathPrefix": "/invite"
            },
            {
              "scheme": "https",
              "host": "dompet-bareng.vercel.app",
              "pathPrefix": "/invite"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan Dompet Bareng mengakses kamera untuk memindai QR undangan dompet.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FBF7F0"
        }
      ],
      "expo-updates",
      "./plugins/withWidgetBootReceiver",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "OtterWidgetSmall",
              "label": "Dompet Bareng Kecil (2×2)",
              "description": "Pengeluaran hari ini dalam tampilan ringkas (2×2)",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "targetCellWidth": 2,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/otter-small.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "OtterWidget",
              "label": "Dompet Bareng Sedang (4×2)",
              "description": "Pengeluaran hari ini dan saran otter (4×2)",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/otter-widget.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "OtterWidgetLarge",
              "label": "Dompet Bareng Besar (4×4)",
              "description": "Ringkasan pengeluaran dan detail dompet (4×4)",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "previewImage": "./assets/widget-preview/otter-large.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 3000,
      "url": "https://u.expo.dev/763c45e6-04da-426c-923d-c72da18c1d7c"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "763c45e6-04da-426c-923d-c72da18c1d7c"
      }
    },
    "owner": "faishaltsq"
  }
}
