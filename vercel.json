{
  "version": 2,
  "buildCommand": "npx expo export -p web",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/invite/:token",
      "destination": "/invite/%5Btoken%5D"
    },
    {
      "source": "/transaction/:id",
      "destination": "/transaction/%5Bid%5D"
    }
  ]
}
